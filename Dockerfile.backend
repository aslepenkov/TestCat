# Agent Service Dockerfile - AI Agent with integrated CLI
FROM node:22-alpine

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache docker-cli

# Copy package files first for better layer caching
RUN npm install -g pnpm@12.8.1

COPY src/backend-service/package.json src/backend-service/pnpm-lock.yaml src/backend-service/pnpm-workspace.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY src/backend-service/ ./

# Build application using esbuild (configured to keep external dependencies)
RUN pnpm run build

# Generate Swagger documentation
RUN pnpm run swagger

# Ensure swagger-output.json exists
RUN test -d ./dist
RUN test -f ./dist/swagger-output.json

# Remove everything except dist/, node_modules/, and package files, then clean dev dependencies
RUN find . -maxdepth 1 -type d -not -name '.' -not -name 'dist' -not -name 'node_modules' -exec rm -rf {} + && \
    pnpm prune --prod

# Create required directories
RUN mkdir -p /app/logs /app/input /app/output /app/prompt

# Start backend server
CMD ["node", "dist/index.js"]
