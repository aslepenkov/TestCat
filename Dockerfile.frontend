# Frontend Dockerfile - Node.js development server
FROM node:22-alpine

WORKDIR /app

# Copy package files
RUN npm install -g pnpm@12.8.1

COPY src/frontend-service/package.json src/frontend-service/pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY src/frontend-service/ ./

# Expose port 80
EXPOSE 80

# Start the frontend server
CMD ["pnpm", "start"]
