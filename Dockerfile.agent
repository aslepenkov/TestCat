# Agent Service Dockerfile - AI Agent with integrated CLI
FROM node:22-alpine

WORKDIR /app

# # Install system dependencies
# RUN apk add --no-cache wget curl

# Copy package files first for better layer caching
RUN npm install -g pnpm@12.8.1

COPY src/agent-service/package.json src/agent-service/pnpm-lock.yaml src/agent-service/pnpm-workspace.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source code
COPY src/agent-service/ ./

# Build application using esbuild (configured to keep external dependencies)
RUN pnpm run build

# Remove everything except dist/, node_modules/, and package files, then clean dev dependencies
RUN find . -maxdepth 1 -type d -not -name '.' -not -name 'dist' -not -name 'node_modules' -exec rm -rf {} + && \
    pnpm prune --prod

# Create required directories
RUN mkdir -p /app/logs /app/input /app/output /app/prompt

# Set executable permissions for the CLI
RUN chmod +x /app/dist/index.js

# Create a CLI wrapper script with proper newline
RUN printf '#!/bin/sh\nnode /app/dist/index.js "$@"\n' > /usr/local/bin/testcatai && \
    chmod +x /usr/local/bin/testcatai

# Default command keeps container running for manual CLI usage
# Users can exec into this container to run CLI commands
CMD ["tail", "-f", "/dev/null"]
